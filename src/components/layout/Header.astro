---
// Paraglide
import * as m from "@/paraglide/messages";
import { localizeHref } from "@/paraglide/runtime";
// Componentes
import LanguagePicker from "./LanguagePicker";
import AuthButton from "../auth/AuthButton";
import ThemeToggle from "./ThemeToggle";
import MobileMenu from "./MobileMenu.astro";

// 1. Obtiene el idioma actual de la URL
const currentLang: 'es' | 'en' = (Astro.currentLocale === 'en' ? 'en' : 'es');

// 2. Verifica si la ruta actual coincide con la del link de navegación
const isActive = (path: string) => {
  const target = localizeHref(path, { locale: currentLang });
  return Astro.url.pathname === target || Astro.url.pathname === `${target}/`;
};
---

<header class="w-full border-b border-border/50">
  <nav aria-label="Navegación principal" class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    <!-- Logo -->
    <div class="flex items-center gap-2">
      <a
        href={localizeHref("/", { locale: currentLang })}
        class="flex items-center gap-2 group transition-transform hover:scale-105"
      >
        <span class="text-2xl">🍅</span>
        <span
          class="text-xl font-black text-foreground dark:text-white tracking-tighter"
        >
          Tempo
        </span>
      </a>
    </div>

    <!-- Desktop Nav Links -->
    <div class="hidden lg:flex items-center gap-8">
      <a
        href={localizeHref("/about", { locale: currentLang })}
        class={`
          text-sm font-medium tracking-normal transition-all duration-200 border-b-2 pb-1
          ${isActive('/about')
            ? 'opacity-100 border-primary text-primary'
            : 'opacity-60 hover:opacity-100 border-transparent'}
        `}
      >
        {m.nav_about({}, { locale: currentLang })}
      </a>
      <a
        href={localizeHref("/blog", { locale: currentLang })}
        class={`
          text-sm font-medium tracking-normal transition-all duration-200 border-b-2 pb-1
          ${isActive('/blog')
            ? 'opacity-100 border-primary text-primary'
            : 'opacity-60 hover:opacity-100 border-transparent'}
        `}
      >
        {m.nav_blog({}, { locale: currentLang })}
      </a>
    </div>

    <!-- Desktop Actions -->
    <div class="hidden lg:flex items-center gap-1">
      <ThemeToggle client:load />
      <LanguagePicker lang={currentLang} client:load />
      <AuthButton
        client:only="react"
        loginUrl={localizeHref("/login", { locale: currentLang })}
        loginText={m.nav_login({}, { locale: currentLang })}
        logoutText={m.nav_logout({}, { locale: currentLang })}
      />
    </div>

    <!-- Mobile Actions -->
    <div class="flex lg:hidden items-center gap-2">
      <AuthButton
        client:only="react"
        loginUrl={localizeHref("/login", { locale: currentLang })}
        loginText={m.nav_login({}, { locale: currentLang })}
        logoutText={m.nav_logout({}, { locale: currentLang })}
      />
      <MobileMenu lang={currentLang} />
    </div>
  </nav>
</header>
