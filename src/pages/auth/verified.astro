---
// Layout
import Layout from '../../layouts/Layout.astro';
// Paraglide
import * as m from '@/paraglide/messages';
import { localizeHref } from '@/paraglide/runtime';

const lang = ((Astro.url.searchParams.get('lang') as 'es' | 'en') || Astro.currentLocale || 'es') as 'es' | 'en';
---

<Layout title={lang === 'en' ? 'Email verified | Tempo' : 'Email verificado | Tempo'} lang={lang}>
	<div class="min-h-screen flex items-center justify-center py-8 px-4">
		<div class="text-center space-y-6 animate-fade-in-up max-w-md">
			<div class="text-7xl">✅</div>
			<h1 class="text-3xl font-black">
				{m.auth_verified_title({}, { locale: lang })}
			</h1>
			<p class="text-muted-foreground text-lg">
				{m.auth_verified_message({}, { locale: lang })}
			</p>
			<a href={localizeHref("/login", { locale: lang })} data-astro-reload class="inline-flex h-9 items-center justify-center rounded-lg bg-primary px-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/80 transition-all mt-4">
				{m.auth_verified_cta({}, { locale: lang })}
			</a>
		</div>
	</div>
</Layout>
