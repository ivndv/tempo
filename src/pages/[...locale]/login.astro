---
// Layout
import Layout from '../../layouts/Layout.astro';
// Componentes
import AuthForm from '../../components/auth/AuthForm';
import { getLocale, localizeHref } from '@/paraglide/runtime';

export function getStaticPaths() {
	return [
		{ params: { locale: undefined } },
		{ params: { locale: 'en' } },
	];
}

const lang = getLocale();
const title = lang === 'en' ? 'Log In | Tempo' : 'Acceder | Pomodoro';
---

<Layout title={title} lang={lang}>
	<div class="min-h-screen flex items-center justify-center py-8 sm:py-12 px-3 sm:px-6 lg:px-8 transition-colors duration-300">
		<AuthForm client:only="react" redirectPath={localizeHref('/')} lang={lang} />
	</div>
</Layout>
