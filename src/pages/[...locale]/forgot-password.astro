---
// Layout
import Layout from '../../layouts/Layout.astro';
// Componentes
import ForgotPasswordForm from '../../components/auth/ForgotPasswordForm';
import { getLocale, localizeHref } from '@/paraglide/runtime';

export function getStaticPaths() {
	return [
		{ params: { locale: undefined } },
		{ params: { locale: 'en' } },
	];
}

const lang = getLocale();
const title = lang === 'en' ? 'Recover Password | Tempo' : 'Recuperar Contraseña | Tempo';
---

<Layout title={title} lang={lang}>
	<div class="min-h-screen flex items-center justify-center py-8 sm:py-12 px-3 sm:px-6 lg:px-8">
		<ForgotPasswordForm client:only="react" redirectPath={localizeHref('/')} lang={lang} />
	</div>
</Layout>
