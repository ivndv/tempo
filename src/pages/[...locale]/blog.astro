---
// Layout
import Layout from '../../layouts/Layout.astro';
// Paraglide
import * as m from '@/paraglide/messages';
import { getLocale, localizeHref } from '@/paraglide/runtime';

export function getStaticPaths() {
	return [
		{ params: { locale: undefined } },
		{ params: { locale: 'en' } },
	];
}

const lang = getLocale();
---

<Layout title={m.blog_title()} description={m.blog_description()} lang={lang}>
    <div class="max-w-4xl mx-auto py-16 text-center space-y-6">
        <h1
            class="text-4xl md:text-5xl font-black text-foreground dark:text-white tracking-tight"
        >
            {m.blog_title()}
        </h1>
        <p class="text-xl text-muted-foreground">{m.blog_coming_soon()}</p>
        <div class="rounded-2xl bg-card border border-border/60 p-8 shadow-sm space-y-5 max-w-lg mx-auto">
            <p class="text-base text-foreground/90 leading-relaxed">
                {m.blog_body()}
            </p>
            <div class="pt-2">
                <a
                    href={localizeHref("/")}
                    class="inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-all shadow-md hover:scale-[1.02]"
                >
                    {m.blog_back()}
                </a>
            </div>
        </div>
    </div>
</Layout>
