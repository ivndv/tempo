---
// Layout
import Layout from "../layouts/Layout.astro";
// Paraglide
import * as m from "@/paraglide/messages";
import { localizeHref } from "@/paraglide/runtime";

const lang = (Astro.currentLocale ?? "es") as "es" | "en";
---

<Layout title={m.page_404_title({}, { locale: lang })}>
  <div
    class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6 animate-fade-in"
  >
    <div
      class="text-8xl md:text-9xl font-black bg-gradient-to-b from-primary/30 to-primary/5 bg-clip-text text-transparent select-none tracking-tighter"
    >
      404
    </div>
    <h1 class="text-3xl md:text-4xl font-black text-foreground dark:text-white tracking-tight">
      {m.page_404_heading({}, { locale: lang })}
    </h1>
    <p class="text-base md:text-lg text-muted-foreground max-w-md">
      {m.page_404_description({}, { locale: lang })}
    </p>
    <div class="pt-2">
      <a
        href={localizeHref("/", { locale: lang })}
        class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-md hover:bg-primary/90 hover:scale-[1.02] transition-all"
      >
        {m.page_404_back({}, { locale: lang })}
      </a>
    </div>
  </div>
</Layout>
