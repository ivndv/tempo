{
	"name": "tempo",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"dev:full": "astro build && wrangler pages dev dist/ --compatibility-date=2026-04-30 --ip localhost --port 4321",
		"prebuild": "bun install",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"sync:db": "wrangler d1 export pomodoro-db --remote --output=.wrangler/pomodoro-db.sql -y && rm -rf .wrangler/state/v3/d1 && wrangler d1 execute pomodoro-db --local --file=.wrangler/pomodoro-db.sql",
		"db:gen": "drizzle-kit generate",
		"db:check": "drizzle-kit check",
		"db:pull": "drizzle-kit pull --config=drizzle.pull.config.ts",
		"db:apply:local": "wrangler d1 execute pomodoro-db --local --file=",
		"db:apply:remote": "wrangler d1 execute pomodoro-db --remote --file=",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"check": "biome check .",
		"seed:e2e": "bun tests/support/seed.ts",
		"test:e2e": "bun run seed:e2e && playwright test",
		"test:visual": "bun run seed:e2e && playwright test tests/e2e/visual/visual.spec.ts",
		"test:visual:update": "bun run seed:e2e && playwright test tests/e2e/visual/visual.spec.ts --update-snapshots",
		"test:a11y": "bun run seed:e2e && playwright test tests/e2e/a11y/a11y.spec.ts",
		"test:smoke": "bun run build && playwright test --config=playwright.smoke.config.ts",
		"test:unit": "vitest run",
		"gen:secret": "bun -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
		"snyk:auth": "snyk auth",
		"snyk:test": "snyk test",
		"snyk:monitor": "snyk monitor"
	},
	"overrides": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.3",
		"@astrojs/react": "7.1.2",
		"@astrojs/sitemap": "^3.7.4",
		"@base-ui/react": "^1.9.0",
		"@better-auth/drizzle-adapter": "1.7.14",
		"@fontsource/outfit": "^5.3.0",
		"@hono/swagger-ui": "^0.6.2",
		"@hono/zod-openapi": "^1.6.3",
		"@iconify-json/lucide": "^1.2.149",
		"@iconify/react": "^6.0.3",
		"@marsidev/react-turnstile": "^1.6.3",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.4.4",
		"better-auth": "1.7.14",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.14",
		"next-themes": "^0.4.6",
		"oxc-transform-react": "^0.156.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"resend": "^6.37.0",
		"shadcn": "^4.23.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@better-auth/cli": "^1.4.22",
		"@biomejs/biome": "^2.6.4",
		"@cloudflare/workers-types": "^5.20261031.1",
		"@inlang/paraglide-js": "^2.29.3",
		"@playwright/test": "^1.64.1",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^30.1.3",
		"snyk": "^1.1308.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	}
}
